{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "QEMU gdb z6m_debug",
      "type": "cppdbg",
      "request": "launch",
      // "preLaunchTask": "Run qemu-system",
      "program": "${workspaceFolder}/debug_build/build/z6m_debug",
      "cwd": "${workspaceFolder}/debug_build",
      "MIMode": "gdb",
      "miDebuggerPath": "riscv-none-elf-gdb",
      "miDebuggerArgs": "-q -x ${workspaceFolder}/debug_build/.gdbinit ${workspaceFolder}/debug_build/build/z6m_debug -nx",             
      "miDebuggerServerAddress": "localhost:1234",
      "stopAtEntry": true,
      "logging": { "engineLogging": true, "trace": true, "traceResponse": true }
    }
  ]
}
