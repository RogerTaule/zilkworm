cmake_minimum_required(VERSION 3.16)
project(SilkwormRV32Demo C CXX ASM)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_EXTENSIONS OFF)
set(RUST_BUILD_EXT_DIR "${CMAKE_SOURCE_DIR}/out")
set(SW_CONAN_DIR   "${RUST_BUILD_EXT_DIR}/build/conan2")

add_executable(z6m_debug src/sys_getentropy.c src/cppextern.cpp src/main.cpp src/start.S)

if (EXISTS "${SW_CONAN_DIR}/conandeps_legacy.cmake")
  include("${SW_CONAN_DIR}/conandeps_legacy.cmake")
  list(APPEND CMAKE_PREFIX_PATH "${SW_CONAN_DIR}")
endif()

add_library(silkworm_core STATIC IMPORTED GLOBAL)
set_target_properties(silkworm_core PROPERTIES
  IMPORTED_LOCATION "${RUST_BUILD_EXT_DIR}/build/silkworm/core/libsilkworm_core.a"
)
add_dependencies(z6m_debug silkworm_core)


add_library(silkworm_dev STATIC IMPORTED GLOBAL)
set_target_properties(silkworm_dev PROPERTIES
  IMPORTED_LOCATION "${RUST_BUILD_EXT_DIR}/build/silkworm/dev/libsilkworm_dev.a"
)
add_dependencies(z6m_debug silkworm_dev )

target_link_options(z6m_debug PRIVATE -Wl,--start-group)
target_link_libraries(z6m_debug PRIVATE 
 c gcc nosys stdc++ gloss)
target_link_options(z6m_debug PRIVATE -Wl,--end-group)

target_link_options(z6m_debug PRIVATE
  -Wl,--gc-sections
  -Wl,-Map=${CMAKE_BINARY_DIR}/z6m_debug.map
)

## =========== Comment and run and then re-run uncommented ==========
find_package(nlohmann_json REQUIRED)
find_package(magic_enum REQUIRED)
find_package(Microsoft.GSL REQUIRED)
find_package(tl-expected REQUIRED)
target_link_libraries(z6m_debug PRIVATE Microsoft.GSL::GSL)
target_link_libraries(z6m_debug PRIVATE nlohmann_json::nlohmann_json)
target_link_libraries(z6m_debug PRIVATE magic_enum::magic_enum)
target_link_libraries(z6m_debug PRIVATE tl::expected)
## ===================================================================

target_include_directories(z6m_debug PRIVATE "${RUST_BUILD_EXT_DIR}/include")

target_link_libraries(z6m_debug PRIVATE
  # "${RUST_BUILD_EXT_DIR}/build/silkworm/core/libsilkworm_core.a"
  # "${RUST_BUILD_EXT_DIR}/build/silkworm/dev/libsilkworm_dev.a"
  "${RUST_BUILD_EXT_DIR}/lib/libethash.a"
  "${RUST_BUILD_EXT_DIR}/lib/libevmc-instructions.a"
  "${RUST_BUILD_EXT_DIR}/lib/libevmc-loader.a"
  "${RUST_BUILD_EXT_DIR}/lib/libff.a"
  "${RUST_BUILD_EXT_DIR}/lib/libkeccak.a"
  "${RUST_BUILD_EXT_DIR}/build/third_party/secp256k1/libsecp256k1.a"
  "${RUST_BUILD_EXT_DIR}/build/third_party/evmone/libevmone.a"
  "${RUST_BUILD_EXT_DIR}/build/deps/src/blst/libblst.a"
  # "${RUST_BUILD_EXT_DIR}/../prelibs/gmp/libgmp.a"
)